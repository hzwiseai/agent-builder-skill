# WiseCopilot Design MCP connection. Copy this file to .env locally.
# .env is intentionally ignored and must never be committed.
WISECOPILOT_MCP_URL=https://crm.wiseaio.com/design
# Base URL for scripts/design_api_client.py (read-only diagnosis only).
WISECOPILOT_API_BASE_URL=https://crm.wiseaio.com

# Preferred credential: an access key issued in 系统管理 › WiseCopilot 访问.
# The token it returns is limited to the design surface, so a leaked key cannot
# reach account settings, customer data, or other Agents. It is shown once at
# creation, can be revoked from that page, and expires on the date set there.
WISECOPILOT_API_KEY=

# Fallback when no key is configured. A password login returns a full account
# token, so prefer the key above wherever a key can be issued.
WISECOPILOT_USERNAME=
WISECOPILOT_PASSWORD=

# Optional: limits the session to one organization after authentication.
WISECOPILOT_ORG_ID=
